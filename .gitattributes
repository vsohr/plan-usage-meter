# Normalize line endings to LF across the repo (authored cross-platform; runs on
# Linux now). Git auto-detects text vs binary; text is checked out/committed LF.
* text=auto eol=lf

# Scripts must stay LF to run.
*.sh text eol=lf

# Binary assets — never apply EOL conversion.
*.png  binary
*.ico  binary
*.icns binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf  binary
